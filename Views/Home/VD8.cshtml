@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Ví dụ 8 - Đăng ký</title>
    <style>
        table {
            border-collapse: collapse;
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        table, th, td {
            border: 1px solid #777;
        }

        th, td {
            padding: 6px 12px;
        }

        .error {
            color: red;
            font-size: 13px;
        }
    </style>
    <script type="text/javascript">
        function KiemTra() {
            var isValid = true;

            var username = document.getElementById("username").value.trim();
            var password = document.getElementById("password").value;
            var confirmPassword = document.getElementById("confirmPassword").value;

            var errUsername = document.getElementById("errUsername");
            var errPassword = document.getElementById("errPassword");
            var errConfirm = document.getElementById("errConfirm");

            // Reset thông báo lỗi
            errUsername.innerHTML = "";
            errPassword.innerHTML = "";
            errConfirm.innerHTML = "";

            // 1. Kiểm tra Tên đăng nhập không được rỗng
            if (username === "") {
                errUsername.innerHTML = "Vui lòng kiểm tra lại Username";
                isValid = false;
            }

            // 2. Kiểm tra Mật khẩu có độ dài từ 8 ký tự trở lên
            if (password.length < 8) {
                errPassword.innerHTML = "Vui lòng kiểm tra lại Password";
                isValid = false;
            }

            // 3. Kiểm tra Nhập lại mật khẩu phải giống mật khẩu đã nhập
            if (confirmPassword === "" || confirmPassword !== password) {
                errConfirm.innerHTML = "Vui lòng kiểm tra nhập lại Password";
                isValid = false;
            }

            return isValid;
        }
    </script>
</head>
<body>
    <form onsubmit="return KiemTra();">
        <table>
            <tr>
                <th colspan="3" align="center">Đăng ký</th>
            </tr>
            <tr>
                <td>Tên đăng nhập:</td>
                <td><input type="text" id="username" /></td>
                <td><span id="errUsername" class="error"></span></td>
            </tr>
            <tr>
                <td>Mật khẩu:</td>
                <td><input type="password" id="password" /></td>
                <td><span id="errPassword" class="error"></span></td>
            </tr>
            <tr>
                <td>Nhập lại mật khẩu:</td>
                <td><input type="password" id="confirmPassword" /></td>
                <td><span id="errConfirm" class="error"></span></td>
            </tr>
            <tr>
                <td colspan="3" align="center">
                    <input type="submit" value="Đăng ký" />
                </td>
            </tr>
        </table>
    </form>
</body>
</html>